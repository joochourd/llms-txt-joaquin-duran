root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 150
ktlint_code_style = ktlint_official
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_blank-line-before-declaration = enabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_class-signature = disabled
# Respect expression bodies that remain readable on one line.
ktlint_function_signature_body_expression_wrapping = default
# Import cleanup is separate from the formatting convention.
ktlint_standard_no-wildcard-imports = disabled

[src/test/**/*.kt]
ktlint_ignore_back_ticked_identifier = true

[src/main/kotlin/com/joaquinduran/llmstxt/crawl/fetch/SafeTransport.kt]
# Keep the annotated constructor inline without indenting the entire class body.
ktlint_standard_annotation = disabled
