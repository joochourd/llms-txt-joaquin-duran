# Nonsecret runtime settings only. Store real runtime credentials as sealed Railway variables.
APP_ENV=aws
PORT=8080
AWS_REGION=us-east-1
DYNAMODB_TABLE=llms-txt-production
AWS_EC2_METADATA_DISABLED=true
PIPELINE_VERSION=deterministic-v4
WORK_INDEX_SHARDS=1
DUE_INDEX_SHARDS=1
# Replace with verified ingress proxy CIDRs before accepting public API traffic.
TRUSTED_PROXY_CIDRS=
CRAWL_ENABLED=true
MAX_CONCURRENT_CRAWLS=12
MAX_PAGES=10
MAX_SELECTED_RESOURCES=10
MAX_REQUESTS=60
MAX_CRAWL_DURATION_SECONDS=180
MAX_OUTSTANDING_RUNS=40
MAX_MONITORED_IDENTITIES=50
MONITOR_INTERVAL_SECONDS=86400
MONITOR_WINDOW_SECONDS=604800
JAVA_OPTS=-Xmx384m -Dfile.encoding=UTF-8
