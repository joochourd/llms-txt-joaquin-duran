# Dummy development values only. Compose sets its internal endpoint separately.
APP_ENV=local
PORT=8080
PIPELINE_VERSION=deterministic-v4
DYNAMODB_TABLE=llms-txt-local
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=localSecret
WORK_INDEX_SHARDS=1
DUE_INDEX_SHARDS=1
API_IO_THREADS=8
API_IO_QUEUE_CAPACITY=32
MAX_BATCH_URLS=1000
MAX_API_BODY_BYTES=2097152
MAX_OPEN_BULK_BATCHES=5
MAX_URL_BYTES=2048
BATCH_ADMISSION_TIMEOUT_SECONDS=30
MAX_OUTSTANDING_RUNS=40
MAX_MONITORED_IDENTITIES=50
CRAWL_FRESHNESS_TTL_SECONDS=900
MAX_CRAWL_DURATION_SECONDS=180
RUN_RECOVERY_GRACE_SECONDS=30
FORCE_IDENTITY_COOLDOWN_SECONDS=60
BATCH_RETENTION_DAYS=7
MAX_DEPTH=3
MAX_PAGES=10
MAX_CANDIDATES=300
MAX_URL_EVALUATIONS=2000
MAX_LINKS_INSPECTED=5000
MAX_REQUESTS=60
MAX_SELECTED_RESOURCES=10
API_READS_PER_MINUTE_PER_CLIENT=120
API_SUBMISSIONS_PER_MINUTE_PER_CLIENT=6
API_SUBMISSIONS_PER_MINUTE_GLOBAL=30
API_URLS_PER_MINUTE_PER_CLIENT=1000
API_URLS_PER_MINUTE_GLOBAL=2000
FORCE_REQUESTS_PER_5_MINUTES_PER_CLIENT=3
LOG_LEVEL=INFO
# Empty means direct connections; never guess a production proxy range.
TRUSTED_PROXY_CIDRS=

# Safe crawling, durable execution and automatic monitoring.
CRAWL_ENABLED=true
MAX_CONCURRENT_CRAWLS=12
MAX_ACTIVE_CRAWLS_PER_ORIGIN=1
MAX_REQUESTS_PER_ORIGIN=1
MIN_REQUEST_INTERVAL_MILLIS=1000
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=2097152
MAX_ROBOTS_BYTES=524288
MAX_SITEMAP_BYTES=1048576
MAX_SITEMAP_DOCUMENTS=3
MAX_SITEMAP_ENTRIES=1000
MAX_REDIRECTS=5
ROBOTS_CACHE_TTL_SECONDS=900
ORIGIN_STATE_IDLE_TTL_SECONDS=900
ORIGIN_CACHE_MAX_ENTRIES=1000
MAX_LLMS_BYTES=65536
MAX_RESOURCE_METADATA_BYTES=8192
TITLE_MAX_CHARS=120
DESCRIPTION_MAX_CHARS=240
ORIGIN_DEFAULT_BACKOFF_SECONDS=60
DISPATCH_POLL_SECONDS=2
DISPATCH_CANDIDATE_LIMIT=40
RUN_RETENTION_DAYS=7
MONITOR_INTERVAL_SECONDS=86400
MONITOR_WINDOW_SECONDS=604800

# Bounded automatic monitoring.
SCHEDULER_TICK_SECONDS=5
SCHEDULER_CANDIDATE_LIMIT=40
MONITOR_PENDING_RECHECK_SECONDS=60
MONITOR_FAILURE_BACKOFF_SECONDS=900
